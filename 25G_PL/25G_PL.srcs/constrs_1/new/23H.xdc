# Input clock periods. These duplicate the values entered for the
# input clocks. You can use these to time your system. If required
# commented constraints can be used in the top level xdc
#----------------------------------------------------------------
# Connect to input port when clock capable pin is selected for input
current_instance -quiet
create_clock -period 20.000 [get_ports i_clk_50m]
set_input_jitter [get_clocks -of_objects [get_ports i_clk_50m]] 0.200


current_instance u_h_top/u_ad9226/ad_clk/inst
set_false_path -to [get_cells -hier {*seq_reg*[0]} -filter is_sequential]
set_property PHASESHIFT_MODE WAVEFORM [get_cells -hierarchical *adv*]


